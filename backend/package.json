{
  "name": "welldone-alicia-guille-rocio",
  "version": "1.0.0",
  "description": "Proyecto Final Keepcoding 20 Welldone",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc && tsc-alias",
    "lint": "eslint src/",
    "prettier": "prettier --check src/",
    "prettier:fix": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit --passWithNoTests",
    "prisma:sync": "npx prisma migrate dev",
    "prisma:seed": "prisma generate && tsc && tsc-alias && tsx prisma/seed.ts",
    "prisma:reset": "npx prisma migrate reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^10.63.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "prisma": "^6.0.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.0",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
