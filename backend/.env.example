# Variables de la app backend (validadas por EnvironmentService al arrancar).
# Si falta cualquiera de las obligatorias, el proceso no levanta.

# Conexión a Postgres. En local apunta a localhost; en producción, al servicio 'postgres' del compose.
DATABASE_URL=postgresql://admin:admin123@localhost:5432/WelldoneApi
# Secreto para firmar JWT. Usa un valor largo y aleatorio (p. ej. `openssl rand -hex 32`).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Uno de: local | staging | production | test
NODE_ENV=local
PORT=3001
REDIS_URL=redis://localhost:6379

# Opcionales: solo para el envío de correo en local vía Maildev. En producción se omiten.
MAILDEV_HOST=localhost
MAILDEV_PORT=1025

# Variables del docker-compose.yml de desarrollo (Postgres + pgAdmin).
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=WelldoneApi

PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123
